{
  "name": "AIInsight",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "warning",
        "suggestion",
        "spiritual",
        "financial"
      ]
    },
    "content_ar": {
      "type": "string"
    },
    "content_en": {
      "type": "string"
    },
    "is_dismissed": {
      "type": "boolean",
      "default": false
    },
    "is_helpful": {
      "type": "boolean"
    },
    "context_snapshot": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "content_ar",
    "content_en"
  ]
}