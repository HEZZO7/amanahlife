{
  "name": "CourseLog",
  "type": "object",
  "properties": {
    "course_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "total_hours": {
      "type": "number",
      "default": 0
    },
    "completed_hours": {
      "type": "number",
      "default": 0
    },
    "platform": {
      "type": "string"
    }
  },
  "required": [
    "course_name"
  ]
}