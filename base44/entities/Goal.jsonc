{
  "name": "Goal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "personal",
        "financial",
        "spiritual",
        "family",
        "health"
      ]
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "Whether this goal is shared with family members"
    },
    "contributors": {
      "type": "array",
      "description": "List of family member contributions",
      "items": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "contribution": {
            "type": "number",
            "description": "Contribution percentage 0-100"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "category"
  ]
}