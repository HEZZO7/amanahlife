{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "overdue"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "invoice_number",
    "amount",
    "due_date"
  ]
}