{
  "name": "Milestone",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "goal_id",
    "title"
  ]
}