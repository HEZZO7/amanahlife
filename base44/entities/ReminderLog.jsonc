{
  "name": "ReminderLog",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID of the task being reminded about"
    },
    "reminder_type": {
      "type": "string",
      "enum": [
        "1hour",
        "1day",
        "3days"
      ],
      "description": "Type of reminder sent"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reminder was sent"
    },
    "user_email": {
      "type": "string",
      "description": "User who received the reminder"
    },
    "task_title": {
      "type": "string",
      "description": "Task title for reference"
    },
    "task_due_date": {
      "type": "string",
      "format": "date",
      "description": "Task due date"
    }
  },
  "required": [
    "task_id",
    "reminder_type",
    "sent_at",
    "user_email"
  ]
}