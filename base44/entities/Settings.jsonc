{
  "name": "Settings",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "ar"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "dark"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true
    },
    "notify_tasks": {
      "type": "boolean",
      "default": true
    },
    "notify_finance": {
      "type": "boolean",
      "default": true
    },
    "notify_prayer": {
      "type": "boolean",
      "default": true
    },
    "notify_goals": {
      "type": "boolean",
      "default": true
    },
    "notify_wellness": {
      "type": "boolean",
      "default": true
    },
    "notify_ai": {
      "type": "boolean",
      "default": true
    },
    "currency": {
      "type": "string",
      "default": "SAR"
    },
    "currency_symbol": {
      "type": "string",
      "default": "\u0631.\u0633"
    },
    "show_eastern_numerals": {
      "type": "boolean",
      "default": false
    },
    "ramadan_mode_active": {
      "type": "boolean",
      "default": false
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "premium",
        "family"
      ],
      "default": "free"
    },
    "show_hijri_calendar": {
      "type": "boolean",
      "default": true
    },
    "show_islamic_events": {
      "type": "boolean",
      "default": true
    },
    "review_monthly_time": {
      "type": "string",
      "default": "06:00",
      "description": "HH:MM time for monthly review delivery"
    },
    "review_annual_time": {
      "type": "string",
      "default": "08:00",
      "description": "HH:MM time for annual review delivery"
    },
    "review_notify_on_complete": {
      "type": "boolean",
      "default": true,
      "description": "Send notification when review is ready"
    },
    "review_monthly_enabled": {
      "type": "boolean",
      "default": true
    },
    "review_annual_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": []
}