{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "due_time": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "recurring": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "none"
    },
    "goal_id": {
      "type": "string",
      "description": "ID of the parent goal this task belongs to"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Task has been archived"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the task was archived"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the task was marked as completed"
    }
  },
  "required": [
    "title"
  ]
}