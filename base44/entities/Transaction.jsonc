{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ]
    },
    "amount": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "is_halal_verified": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "type",
    "amount",
    "category",
    "date"
  ]
}