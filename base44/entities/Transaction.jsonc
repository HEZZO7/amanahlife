{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ]
    },
    "amount": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "is_halal_verified": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags for search and filtering"
    },
    "auto_categorized": {
      "type": "boolean",
      "default": false,
      "description": "Whether category was set automatically by AI"
    }
  },
  "required": [
    "type",
    "amount",
    "category",
    "date"
  ]
}